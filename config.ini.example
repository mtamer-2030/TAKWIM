; PHILO-TECH v2 — ملفّ الإعداد
; انسخ هذا الملفّ إلى config.ini وعدّله. لا تضع config.ini في المستودع.
; لا مفاتيح في الكود إطلاقاً (CLAUDE.md §14).

[teacher]
; كلمة سرّ لوحة الأستاذ على /admin
; إلزاميّة: يرفض الخادم الإقلاع ما دامت على القيمة الافتراضيّة change-me-please.
password = change-me-please

[server]
; المنفذ الذي يستمع عليه الخادم (0.0.0.0 دائماً)
port = 8000
; العنوان الظاهر في رمز QR الثابت
public_url = http://192.168.1.50:8000
; سرّ توقيع الكوكيز (اختياري): إن تُرك فارغاً يُولَّد ويُحفَظ تلقائياً في data/.secret
; اضبطه يدوياً فقط إن أردت جلسات ثابتة عبر عدّة أجهزة خادم.
; secret_key =

[local_ai]
; محرك ذكاء اصطناعي محلّي (Ollama / LM Studio) — للتقارير وخطط التدخّل العلاجي
; وتصحيح الأسئلة المفتوحة على طاولة الأستاذ. لا سحابة، لا إنترنت.
enabled = true
base_url = http://localhost:11434
; ثبّت النموذج بـ: ollama pull qwen2.5:3b-instruct  (خفيف وسريع؛ 7b أثقل ويتطلّب ذاكرة كرت أكبر)
model = qwen2.5:3b-instruct
timeout = 300

[cloud_ai]
; استيراد ذكيّ لأيّ بنية فرضٍ عبر نموذج Claude قويّ — **وقت التحضير فقط** (يحتاج
; إنترنت). لا يُستعمَل في القاعة؛ الجلسة تبقى محلّية offline. غيابُ المفتاح لا يعطّل
; النظام — يرجع تلقائيّاً للمحلّل القاعديّ اليقينيّ. المفتاح يمكن وضعه هنا أو في
; متغيّر البيئة ANTHROPIC_API_KEY. احصل على مفتاح من: https://console.anthropic.com
; ثمّ ثبّت المكتبة مرّةً: pip install anthropic
api_key =
; النموذج الافتراضيّ اقتصاديّ ودقيق للاستخراج. للأصعب استعمل claude-opus-5.
model = claude-sonnet-5
timeout = 120
