; مِحَكّ — ملفّ الإعداد
; انسخ هذا الملفّ إلى config.ini وعدّله. لا تضع config.ini في المستودع.
; لا مفاتيح في الكود إطلاقاً (CLAUDE.md §14).

[teacher]
; كلمة سرّ لوحة الأستاذ على /teacher
password = change-me-please

[server]
; المنفذ الذي يستمع عليه الخادم (0.0.0.0 دائماً)
port = 8000
; العنوان الظاهر في رمز QR الثابت
public_url = http://192.168.1.50:8000

[local_ai]
; محرك ذكاء اصطناعي محلّي (Ollama / LM Studio) — للتقارير وخطط التدخّل العلاجي
; على طاولة الأستاذ فقط، لا داخل القاعة. لا سحابة، لا إنترنت.
enabled = true
base_url = http://localhost:11434
; ثبّت النموذج بـ: ollama pull qwen2.5:3b-instruct  (خفيف وسريع؛ 7b أثقل ويتطلّب ذاكرة كرت أكبر)
model = qwen2.5:3b-instruct
timeout = 300
